MONGODB_URI=mongodb://user:pass@host:27017/budd_website?authSource=admin
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_DEFAULT_EMAIL=admin@budd.local
ADMIN_DEFAULT_PASSWORD=Admin@1234

# Thư mục lưu ảnh upload — phải là đường dẫn NGOÀI project, persist qua redeploy
# Dokploy: vào Settings → Volumes → thêm binding: /var/data/kct-uploads → /var/data/uploads
UPLOADS_DIR=/var/data/uploads
